# LangoTrace Provider Probe 配置模板
# 复制为 .env 并填入真实凭据后运行各 probe 脚本。
# .env 已在 .gitignore 中排除，不会被提交。

# ==============================================================
# OpenAI
# Base URL: https://api.openai.com/v1
# Auth:     Authorization: Bearer KEY
# TTS:      /audio/speech  (adapter: openAIAudioSpeech)
# ==============================================================
OPENAI_API_KEY=sk-...
OPENAI_TEXT_MODEL=gpt-5.2
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ==============================================================
# OpenRouter
# Base URL: https://openrouter.ai/api/v1
# Auth:     Authorization: Bearer KEY
# TTS:      /chat/completions  multimodal SSE (adapter: openRouterMultimodalAudio)
# ==============================================================
OPENROUTER_API_KEY=REDACTED_OPENROUTER_KEY
OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
OPENROUTER_TTS_VOICE=af_heart

# ==============================================================
# MIMO (Xiaomi MiMo)
# Base URL: https://api.xiaomimimo.com/v1
# Auth:     api-key: KEY  (非标准，非 Bearer)
# TTS:      /chat/completions  非流式 JSON，文本在 assistant role
#           (adapter: mimoTTS)
# ==============================================================
MIMO_API_KEY=REDACTED_MIMO_KEY
MIMO_TEXT_MODEL=mimo-v2.5-pro
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=Chloe

# ==============================================================
# Anthropic
# Base URL: https://api.anthropic.com/v1
# Auth:     x-api-key: KEY
# TTS:      不支持
# ==============================================================
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5

# ==============================================================
# Google Gemini
# Base URL: https://generativelanguage.googleapis.com/v1beta
# Auth:     x-goog-api-key: KEY
# TTS:      规划中，暂不支持
# ==============================================================
GEMINI_API_KEY=AIza...
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ==============================================================
# DeepSeek
# Base URL: https://api.deepseek.com
# Auth:     Authorization: Bearer KEY
# TTS:      不支持
# ==============================================================
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_TEXT_MODEL=deepseek-v4-flash

# ==============================================================
# Mistral
# Base URL: https://api.mistral.ai/v1
# Auth:     Authorization: Bearer KEY
# TTS:      规划中，暂不支持
# ==============================================================
MISTRAL_API_KEY=...
MISTRAL_TEXT_MODEL=mistral-small-latest

# ==============================================================
# Groq
# Base URL: https://api.groq.com/openai/v1
# Auth:     Authorization: Bearer KEY
# TTS:      规划中，暂不支持
# ==============================================================
GROQ_API_KEY=gsk_...
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# ==============================================================
# xAI (Grok)
# Base URL: https://api.x.ai/v1
# Auth:     Authorization: Bearer KEY
# TTS:      规划中，暂不支持
# ==============================================================
XAI_API_KEY=xai-...
XAI_TEXT_MODEL=grok-4.3

# ==============================================================
# Moonshot / Kimi
# Base URL: https://api.moonshot.ai/v1
# Auth:     Authorization: Bearer KEY
# TTS:      不支持
# ==============================================================
MOONSHOT_API_KEY=sk-...
MOONSHOT_TEXT_MODEL=kimi-k2.5

# ==============================================================
# DashScope / Qwen (阿里云)
# Base URL: https://dashscope.aliyuncs.com/compatible-mode/v1
# Auth:     Authorization: Bearer KEY
# TTS:      规划中，暂不支持
# ==============================================================
DASHSCOPE_API_KEY=sk-...
DASHSCOPE_TEXT_MODEL=qwen-plus

# ==============================================================
# Zhipu GLM (智谱)
# Base URL: https://open.bigmodel.cn/api/paas/v4
# Auth:     Authorization: Bearer KEY
# TTS:      规划中，暂不支持
# ==============================================================
ZHIPU_API_KEY=...
ZHIPU_TEXT_MODEL=glm-4.6

# ==============================================================
# SiliconFlow (硅基流动)
# Base URL: https://api.siliconflow.com/v1
# Auth:     Authorization: Bearer KEY
# TTS:      规划中，暂不支持
# ==============================================================
SILICONFLOW_API_KEY=sk-...
SILICONFLOW_TEXT_MODEL=Qwen/Qwen3-32B

# ==============================================================
# Ollama (本地)
# Base URL: http://localhost:11434/v1
# Auth:     无需 API Key
# TTS:      不支持
# ==============================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TEXT_MODEL=llama3.2
