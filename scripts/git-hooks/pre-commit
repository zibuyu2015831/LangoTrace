#!/usr/bin/env bash
# Pre-commit hook: scan staged files for leaked API keys.
#
# Install (one-time, per clone):
#   git config core.hooksPath scripts/git-hooks
#   chmod +x scripts/git-hooks/*
#
# Bypass (false positive only):
#   git commit --no-verify

set -euo pipefail

# Patterns that match real API keys (not placeholder-style values).
# Each pattern is designed to match realistic key entropy, not documentation examples.
PATTERNS=(
  'sk-or-v1-[a-f0-9]{60,}'            # OpenRouter
  'sk-ant-api[0-9]+-[A-Za-z0-9_-]{90,}' # Anthropic (full key is ~100 chars after prefix)
  'sk-[a-zA-Z0-9]{48,}'               # OpenAI style (≥48 chars to avoid matching sk-... placeholders)
  'sk-ck[a-z0-9]{40,}'                # MIMO / Xiaomi
  'AIza[0-9A-Za-z_-]{35}'             # Google API key
  'gsk_[a-zA-Z0-9]{50,}'              # Groq
  'xai-[a-zA-Z0-9]{80,}'              # xAI / Grok
)

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)

if [[ -z "$STAGED_FILES" ]]; then
  exit 0
fi

FOUND=0

while IFS= read -r file; do
  [[ -z "$file" ]] && continue
  # Read staged content (not working-tree content)
  content=$(git show ":${file}" 2>/dev/null) || continue

  for pattern in "${PATTERNS[@]}"; do
    if echo "$content" | grep -qE "$pattern" 2>/dev/null; then
      echo "ERROR: Potential API key detected in staged file: ${file}"
      echo "       Pattern: ${pattern}"
      FOUND=1
    fi
  done
done <<< "$STAGED_FILES"

if [[ "$FOUND" -eq 1 ]]; then
  echo ""
  echo "Commit rejected: real API key pattern found in staged files."
  echo "  - If this is a false positive, use: git commit --no-verify"
  echo "  - Otherwise, remove the key and use a placeholder (e.g. sk-or-v1-...)"
  exit 1
fi

exit 0
