    "requestPreview.notSent": {
      "comment": "Request preview exclusion list.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not sent: local database, full photo library, API keys, or unselected history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会发送：本地数据库、完整照片库、API Key、未选中的历史记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envían: base de datos local, fototeca completa, claves API ni historial no seleccionado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信されないもの: ローカルデータベース、写真ライブラリ全体、APIキー、未選択の履歴。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non envoyés : base de données locale, photothèque complète, clés API ou historique non sélectionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht gesendet: lokale Datenbank, gesamte Fotomediathek, API-Schlüssel oder nicht ausgewählter Verlauf."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송되지 않음: 로컬 데이터베이스, 전체 사진 보관함, API 키, 선택하지 않은 기록."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отправляются: локальная база данных, вся фототека, API-ключи и невыбранная история."
