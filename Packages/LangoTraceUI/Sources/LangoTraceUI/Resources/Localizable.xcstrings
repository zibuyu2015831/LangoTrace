    "welcome.valueSubtitle": {
      "comment": "Welcome value subtitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos and jot notes. LangoTrace turns them into expressions and practice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照、随笔，\n语迹会帮你整理成表达和练习"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz fotos y toma notas. LangoTrace las convierte en expresiones y práctica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とメモを、LangoTrace が表現と練習に整理します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez des photos et notez vos pensées. LangoTrace en fait des expressions et des exercices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere und notiere Gedanken. LangoTrace macht daraus Ausdrücke und Übungen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 짧은 글을 LangoTrace가 표현과 연습으로 정리합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте фото и делайте заметки. LangoTrace превращает их в выражения и практику."
          }
        }
      }
    },
    "welcome.valueTitle": {
      "comment": "Welcome value-first headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn life\ninto your language material."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把生活，\n变成你的语言素材。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte tu vida\nen material de idioma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日常を\n言語素材に変える。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez la vie\nen matière linguistique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach dein Leben\nzu Sprachmaterial."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생활을\n언어 자료로 바꾸세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превратите жизнь\nв языковой материал."
          }
        }
      }
    },
