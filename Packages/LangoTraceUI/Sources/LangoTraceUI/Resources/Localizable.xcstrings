    "hero.subtitle": {
      "comment": "Hero card subtitle. Argument is the target language display name.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a sentence, add a photo, or save what you want to say for later %@ practice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写一句、拍一张照片，或把今天想说的话留给之后的%@练习。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe una frase, añade una foto o guarda lo que quieras decir para practicar %@ más tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一文を書いたり、写真を追加したり、言いたいことを保存して、あとで%@の練習に使いましょう。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez une phrase, ajoutez une photo ou gardez ce que vous voulez dire pour votre prochaine pratique de %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe einen Satz, füge ein Foto hinzu oder speichere, was du sagen möchtest, für die spätere %@-Übung."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 문장을 쓰거나 사진을 추가하거나 하고 싶은 말을 저장해 두었다가 나중에 %@ 연습에 사용하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишите предложение, добавьте фото или сохраните то, что хотите сказать, для будущей практики %@."
          }
        }
      }
    },
