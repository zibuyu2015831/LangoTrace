    "settings.noLanguageSpace.boundary": {
      "comment": "Boundary text in the settings scene when no language space exists yet.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a language space first. Settings that belong to a space become usable once one exists."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先创建语言空间。属于空间的设置会在空间创建后开放。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea primero un espacio de idioma. Los ajustes que pertenecen a un espacio estarán disponibles después."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず言語スペースを作成してください。スペースに属する設定は、その後に利用できるようになります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez d'abord un espace de langue. Les réglages liés à un espace seront ensuite disponibles."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle zuerst einen Sprachraum. Einstellungen, die zu einem Raum gehören, werden danach verfügbar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 언어 공간을 만드세요. 공간에 속한 설정은 그 후에 사용할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создайте языковое пространство. Связанные с пространством настройки станут доступны после этого."
          }
        }
      }
    },
    "settings.privacy.detail": {
      "comment": "Privacy settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive content should only enter request preview and Provider calls after the user explicitly triggers the relevant capability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感内容只有在用户明确触发对应能力时才应进入请求预览和 Provider 调用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido sensible solo debe entrar en la vista previa y llamadas Provider después de que el usuario active explícitamente la capacidad correspondiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密コンテンツは、ユーザーが該当機能を明示的に実行した後にだけ、リクエストプレビューやProvider呼び出しに入るべきです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu sensible ne doit entrer dans l’aperçu de requête et les appels Provider qu’après déclenchement explicite de la capacité par l’utilisateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensible Inhalte sollen erst nach expliziter Auslösung der passenden Funktion in Anfragevorschau und Provider-Aufrufe gelangen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 콘텐츠는 사용자가 해당 기능을 명시적으로 실행한 뒤에만 요청 미리보기와 Provider 호출에 포함되어야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чувствительный контент должен попадать в предпросмотр запроса и вызовы Provider только после явного действия пользователя."
          }
        }
      }
    },
    "settings.privacy.nextRequirement": {
