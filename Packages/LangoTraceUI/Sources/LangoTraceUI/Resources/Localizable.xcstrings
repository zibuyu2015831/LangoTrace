    "welcome.tracePreview.examples.meeting.sourceNote": {
      "comment": "Welcome preview meeting example source note. Fixed bilingual demo copy across interface languages. Welcome demo content switches target language by interface language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In today’s meeting, I wanted to confirm the deadline and ask who owns the next step."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天开会时，我想确认截止时间，也想问下一步由谁负责。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la reunion de hoy queria confirmar la fecha limite y preguntar quien se encarga del siguiente paso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の会議で締め切りを確認し、次のステップを誰が担当するか聞きたい。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la reunion d aujourd hui, je voulais confirmer l echeance et demander qui prendrait la suite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im heutigen Meeting wollte ich die Frist bestaetigen und fragen, wer den naechsten Schritt uebernimmt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 회의에서 마감일을 확인하고 다음 단계를 누가 맡는지 묻고 싶었다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сегодняшней встрече я хотел уточнить срок и спросить, кто отвечает за следующий шаг."
          }
        }
      }
    },
    "welcome.tracePreview.examples.meeting.rewrittenText": {
      "comment": "Welcome preview meeting example rewritten target text. Fixed bilingual demo copy across interface languages. Welcome demo content switches target language by interface language.",
