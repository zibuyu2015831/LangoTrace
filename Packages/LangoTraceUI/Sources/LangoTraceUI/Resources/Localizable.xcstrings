    "launchRecovery.failed.message": {
      "comment": "Message shown on the welcome screen when local storage recovery failed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTrace couldn't open the local storage on this device. Your data stays on this device and is not sent anywhere. Try again, and restart the app if the problem continues."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语迹暂时无法打开本机存储。你的数据仍只保存在本机，不会发送到任何地方。请重试；如果问题持续，请重启 App。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTrace no pudo abrir el almacenamiento local de este dispositivo. Tus datos permanecen en este dispositivo y no se envían a ningún sitio. Inténtalo de nuevo y reinicia la app si el problema continúa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTrace はこのデバイスのローカルストレージを開けませんでした。データはこのデバイスにのみ保存され、どこにも送信されません。再試行し、問題が続く場合はアプリを再起動してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTrace n'a pas pu ouvrir le stockage local de cet appareil. Vos données restent sur cet appareil et ne sont envoyées nulle part. Réessayez, puis redémarrez l'app si le problème persiste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTrace konnte den lokalen Speicher dieses Geräts nicht öffnen. Deine Daten bleiben auf diesem Gerät und werden nirgendwohin gesendet. Versuche es erneut und starte die App neu, falls das Problem bestehen bleibt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTrace가 이 기기의 로컬 저장소를 열지 못했습니다. 데이터는 이 기기에만 저장되며 어디로도 전송되지 않습니다. 다시 시도하고, 문제가 계속되면 앱을 재시동하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTrace не удалось открыть локальное хранилище на этом устройстве. Ваши данные остаются на этом устройстве и никуда не отправляются. Повторите попытку и перезапустите приложение, если проблема сохраняется."
          }
        }
      }
    },
    "launchRecovery.failed.title": {
      "comment": "Title shown on the welcome screen when local storage recovery failed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
