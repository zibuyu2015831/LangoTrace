    "settings.privacy.detail": {
      "comment": "Privacy settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensitive content should only enter request preview and Provider calls after the user explicitly triggers the relevant capability."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "敏感内容只有在用户明确触发对应能力时才应进入请求预览和 Provider 调用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido sensible solo debe entrar en la vista previa y llamadas Provider después de que el usuario active explícitamente la capacidad correspondiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密コンテンツは、ユーザーが該当機能を明示的に実行した後にだけ、リクエストプレビューやProvider呼び出しに入るべきです。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu sensible ne doit entrer dans l’aperçu de requête et les appels Provider qu’après déclenchement explicite de la capacité par l’utilisateur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensible Inhalte sollen erst nach expliziter Auslösung der passenden Funktion in Anfragevorschau und Provider-Aufrufe gelangen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 콘텐츠는 사용자가 해당 기능을 명시적으로 실행한 뒤에만 요청 미리보기와 Provider 호출에 포함되어야 합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чувствительный контент должен попадать в предпросмотр запроса и вызовы Provider только после явного действия пользователя."
          }
        }
      }
    },
    "settings.privacy.nextRequirement": {
      "comment": "Privacy settings next requirement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep confirmation paths when real AI, speech, photos, and sync are added."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在真实 AI、语音、照片和同步接入时保留确认路径。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener rutas de confirmación al añadir IA real, voz, fotos y sincronización."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実AI、音声、写真、同期を追加するときも確認経路を維持します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les chemins de confirmation lors de l’ajout de l’IA réelle, de la voix, des photos et de la sync."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigungspfade beibehalten, wenn echte KI, Sprache, Fotos und Sync hinzukommen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제 AI, 음성, 사진, 동기화가 추가될 때 확인 경로를 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить пути подтверждения при добавлении настоящего ИИ, речи, фото и синхронизации."
          }
        }
      }
    },
