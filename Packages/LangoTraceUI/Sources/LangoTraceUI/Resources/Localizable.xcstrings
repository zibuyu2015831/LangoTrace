    "settings.aiProvider.detail": {
      "comment": "AI Provider settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Request preview only explains what would be sent later. The current app does not read Keychain or make network requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求预览只说明将来会发送哪些内容，当前不会读取 Keychain，也不会发起网络请求。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa solo explica qué se enviaría más tarde. La app actual no lee Keychain ni realiza solicitudes de red."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストプレビューは将来送信される内容を説明するだけです。現在のアプリはKeychainを読まず、ネットワークリクエストも行いません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aperçu de requête explique seulement ce qui serait envoyé plus tard. L’app actuelle ne lit pas le trousseau et n’effectue aucune requête réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfragevorschau erklärt nur, was später gesendet würde. Die aktuelle App liest keinen Keychain und stellt keine Netzwerkanfragen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 미리보기는 나중에 무엇이 전송될지만 설명합니다. 현재 앱은 Keychain을 읽거나 네트워크 요청을 하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предпросмотр запроса только объясняет, что будет отправлено позже. Текущая версия не читает Keychain и не выполняет сетевые запросы."
          }
        }
      }
    },
