    "settings.localData.detail": {
      "comment": "Local data settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After restart, mock content returns to the seed examples. There is no SQLite schema, migration, or attachment storage yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启后 mock 内容会恢复为示例数据；当前没有 SQLite schema、迁移或附件存储。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de reiniciar, el contenido mock vuelve a los ejemplos semilla. Aún no hay esquema SQLite, migraciones ni almacenamiento de adjuntos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動後、mockコンテンツはseedサンプルに戻ります。SQLite schema、migration、添付ファイル保存はまだありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après redémarrage, le contenu mock revient aux exemples de départ. Il n’y a pas encore de schéma SQLite, migration ni stockage de pièces jointes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach dem Neustart kehren Mock-Inhalte zu Seed-Beispielen zurück. Es gibt noch kein SQLite-Schema, keine Migration und keinen Anhangsspeicher."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재시작 후 mock 콘텐츠는 시드 예시로 돌아갑니다. 아직 SQLite schema, migration, 첨부 저장소가 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После перезапуска mock-контент возвращается к исходным примерам. SQLite schema, миграций и хранилища вложений пока нет."
          }
        }
      }
    },
    "settings.localData.nextRequirement": {
      "comment": "Local data settings next requirement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add SQLite / GRDB repositories, migrations, and export boundaries."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入 SQLite / GRDB Repository、迁移和导出边界。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir repositorios SQLite / GRDB, migraciones y límites de exportación."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite / GRDB Repository、migration、エクスポート境界を追加します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter les repositories SQLite / GRDB, migrations et limites d’export."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite-/GRDB-Repositories, Migrationen und Exportgrenzen hinzufügen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SQLite / GRDB Repository, migration, 내보내기 경계를 추가합니다."
          }
        },
        "ru": {
