    "aiProviderSettings.privacy.body": {
      "comment": "Privacy explanation for AI provider settings.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving provider information will not send life entries. Content is sent only when you explicitly start an AI action; this UI pass does not write Keychain data yet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存 Provider 信息不会发送生活记录。只有你主动触发 AI 动作时才会发送选中内容；本轮 UI 还不写入钥匙串。"
          }
        }
      }
    },
