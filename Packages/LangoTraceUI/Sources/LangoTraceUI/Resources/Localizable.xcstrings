    "welcome.valueSubtitle": {
      "comment": "Welcome value subtitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take photos and jot notes. LangoTrace turns them into expressions and practice."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拍照、随笔，\n语迹会帮你整理成表达和练习"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz fotos y toma notas. LangoTrace las convierte en expresiones y práctica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真とメモを、LangoTrace が表現と練習に整理します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez des photos et notez vos pensées. LangoTrace en fait des expressions et des exercices."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere und notiere Gedanken. LangoTrace macht daraus Ausdrücke und Übungen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진과 짧은 글을 LangoTrace가 표현과 연습으로 정리합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимайте фото и делайте заметки. LangoTrace превращает их в выражения и практику."
          }
        }
      }
    },
    "welcome.valueTitle": {
      "comment": "Welcome value-first headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn life\ninto your language material."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把生活，\n变成你的语言素材。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte tu vida\nen material de idioma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日常を\n言語素材に変える。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez la vie\nen matière linguistique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach dein Leben\nzu Sprachmaterial."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생활을\n언어 자료로 바꾸세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Превратите жизнь\nв языковой материал."
          }
        }
      }
    },
    "welcome.subtitle": {
      "comment": "Welcome subtitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparing your language space. First use asks for native language, target language, and current level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备你的语言空间。首次使用会先询问母语、目标语言和当前水平。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparando tu espacio de idioma. El primer uso pregunta lengua materna, idioma objetivo y nivel actual."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語スペースを準備しています。初回利用時に母語、目標言語、現在のレベルを尋ねます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparation de votre espace de langue. La première utilisation demande la langue maternelle, la langue cible et le niveau actuel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Sprachraum wird vorbereitet. Beim ersten Start fragt die App nach Muttersprache, Zielsprache und aktuellem Niveau."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 공간을 준비하는 중입니다. 처음 사용할 때 모국어, 목표 언어, 현재 수준을 묻습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовка языкового пространства. При первом запуске будут запрошены родной язык, целевой язык и текущий уровень."
          }
        }
      }
    },
