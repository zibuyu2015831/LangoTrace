    "entryEditor.bodyField.accessibilityHint": {
      "comment": "Accessibility hint for the entry body editor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Writes the life moment that will be saved locally."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填写将保存在本地的生活片段。"
