    "entryEditor.privacy.localOnly": {
      "comment": "Privacy note in local entry editor.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved locally as Local Mock. Nothing is sent to external AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前为本地保存和 Local Mock，不会发送到外部 AI。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda localmente como Mock local. No se envía nada a una IA externa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルMockとして端末内に保存されます。外部AIには送信されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistré localement comme mock local. Rien n’est envoyé à une IA externe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird lokal als lokaler Mock gespeichert. Es wird nichts an externe KI gesendet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 Mock으로 기기에 저장됩니다. 외부 AI로 전송되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняется локально как локальный mock. Ничего не отправляется внешнему ИИ."
          }
        }
      }
    },
