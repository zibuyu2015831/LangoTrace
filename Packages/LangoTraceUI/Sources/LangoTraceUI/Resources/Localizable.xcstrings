    "settings.sync.detail": {
      "comment": "Sync settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries, photos, vector indexes, and API keys are not synced in the current build."
          }
        },
        "zh-Hans": {
