    "settings.interfaceLanguage.selectionFootnote": {
      "comment": "Concise footnote for the interface language selection page.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only changes the LangoTrace interface. Language spaces and saved content stay unchanged."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅影响语迹界面，不改变语言空间或已保存内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cambia la interfaz de LangoTrace. Los espacios y el contenido guardado no cambian."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTraceの界面だけが変わります。言語スペースと保存済み内容は変わりません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Change seulement l’interface de LangoTrace. Les espaces et contenus enregistrés restent inchangés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändert nur die LangoTrace-Oberfläche. Sprachräume und gespeicherte Inhalte bleiben unverändert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LangoTrace 인터페이스만 바뀝니다. 언어 공간과 저장된 내용은 그대로입니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меняется только интерфейс LangoTrace. Языковые пространства и сохраненное содержимое не меняются."
          }
        }
      }
    },
    "settings.interfaceLanguage.detail": {
      "comment": "Interface language settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface language only affects app chrome. It does not change the user's native language, target language, or rewrite generated content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面语言只影响 App chrome，不改变用户母语、不改变目标语言，也不重写已生成内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de interfaz solo afecta al chrome de la app. No cambia la lengua materna, el idioma objetivo ni reescribe contenido generado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "界面言語はアプリのchromeだけに影響します。母語や目標言語を変えず、生成済みコンテンツも書き換えません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue d’interface n’affecte que le chrome de l’app. Elle ne change pas la langue maternelle, la langue cible et ne réécrit pas le contenu généré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberflächensprache betrifft nur die App-Chrome. Sie ändert weder Muttersprache noch Zielsprache und schreibt keine generierten Inhalte um."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 언어는 앱 chrome에만 영향을 줍니다. 모국어, 목표 언어를 바꾸거나 생성된 콘텐츠를 다시 쓰지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык интерфейса влияет только на chrome приложения. Он не меняет родной или целевой язык и не переписывает созданный контент."
          }
        }
      }
    },
