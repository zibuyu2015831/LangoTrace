            "state": "translated",
            "value": "Añadir persistencia real de espacios de idioma y restauración al inicio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実際の言語スペース永続化と起動時復元を追加します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
