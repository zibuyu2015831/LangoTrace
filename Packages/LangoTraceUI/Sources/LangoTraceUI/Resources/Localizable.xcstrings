    "privacyStatus.ai.summary.configured": {
      "comment": "AI provider privacy summary when configured. Must not promise a request preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content is sent only when you explicitly trigger an AI feature. Your API key stays in this device's secure storage."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你显式触发 AI 功能时，才会发送当前内容。API Key 保存在本机安全存储中。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido solo se envía cuando activas explícitamente una función de IA. Tu API key permanece en el almacenamiento seguro de este dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 機能を明示的に実行したときにのみ内容が送信されます。API Key はこのデバイスの安全なストレージに保存されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu n'est envoyé que lorsque vous déclenchez explicitement une fonction IA. Votre clé API reste dans le stockage sécurisé de cet appareil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalte werden nur gesendet, wenn du eine KI-Funktion ausdrücklich auslöst. Dein API-Key bleibt im sicheren Speicher dieses Geräts."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 기능을 직접 실행할 때만 내용이 전송됩니다. API Key는 이 기기의 보안 저장소에 보관됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Содержимое отправляется только тогда, когда вы явно запускаете функцию ИИ. Ваш API-ключ хранится в защищённом хранилище этого устройства."
          }
        }
      }
    },
    "privacyStatus.ai.summary.error": {
      "comment": "AI provider privacy summary when configuration or the last request failed.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI provider configuration has an error or the last request failed. Check the provider, model, and key in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Provider 配置存在错误或最近一次请求失败。请在设置中检查 Provider、模型和密钥。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración del provider de IA tiene un error o la última solicitud falló. Revisa el provider, el modelo y la clave en Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Provider の設定にエラーがあるか、直近のリクエストが失敗しました。設定で Provider・モデル・キーを確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration du provider IA contient une erreur ou la dernière requête a échoué. Vérifiez le provider, le modèle et la clé dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI-Provider-Konfiguration hat einen Fehler oder die letzte Anfrage ist fehlgeschlagen. Prüfe Provider, Modell und Schlüssel in den Einstellungen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI Provider 설정에 오류가 있거나 최근 요청이 실패했습니다. 설정에서 Provider, 모델, 키를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В конфигурации ИИ-провайдера есть ошибка или последний запрос завершился неудачно. Проверьте провайдера, модель и ключ в настройках."
          }
        }
      }
    },
    "privacyStatus.ai.summary.notConfigured": {
      "comment": "AI provider privacy summary when no provider is configured. Must not promise a request preview.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No text, photo summaries, or related memories are sent right now. After you configure a provider, content is sent only when you explicitly trigger an AI feature."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前不会发送文本、照片摘要或相似记忆。配置后，只有你显式触发 AI 功能时才会发送当前内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se envían textos, resúmenes de fotos ni recuerdos relacionados. Tras configurar un provider, el contenido solo se envía cuando activas explícitamente una función de IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、テキスト・写真の要約・関連する記憶は送信されません。Provider を設定した後も、AI 機能を明示的に実行したときにのみ内容が送信されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun texte, résumé de photo ou souvenir associé n'est envoyé pour le moment. Après configuration d'un provider, le contenu n'est envoyé que lorsque vous déclenchez explicitement une fonction IA."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit werden keine Texte, Foto-Zusammenfassungen oder verwandte Erinnerungen gesendet. Nach der Konfiguration werden Inhalte nur gesendet, wenn du eine KI-Funktion ausdrücklich auslöst."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 텍스트, 사진 요약, 관련 기억이 전송되지 않습니다. Provider를 설정한 후에도 AI 기능을 직접 실행할 때만 내용이 전송됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас тексты, сводки фото и связанные воспоминания не отправляются. После настройки провайдера содержимое отправляется только тогда, когда вы явно запускаете функцию ИИ."
          }
        }
      }
    },
    "privacyStatus.ai.summary.unavailable": {
      "comment": "AI provider privacy summary when temporarily unavailable.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI features are temporarily unavailable due to the current platform, network, permission, or configuration conditions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前平台、网络、权限或配置条件导致 AI 能力暂不可用。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones de IA no están disponibles temporalmente debido a las condiciones actuales de plataforma, red, permisos o configuración."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプラットフォーム・ネットワーク・権限・設定の状況により、AI 機能は一時的に利用できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions IA sont temporairement indisponibles en raison des conditions actuelles de plateforme, de réseau, d'autorisations ou de configuration."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Funktionen sind wegen der aktuellen Plattform-, Netzwerk-, Berechtigungs- oder Konfigurationsbedingungen vorübergehend nicht verfügbar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 플랫폼, 네트워크, 권한 또는 설정 조건으로 인해 AI 기능을 일시적으로 사용할 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции ИИ временно недоступны из-за текущих условий платформы, сети, разрешений или конфигурации."
          }
        }
      }
    },
