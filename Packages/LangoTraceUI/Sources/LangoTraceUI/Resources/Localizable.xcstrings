    "welcome.tracePreview.examples.meeting.note": {
      "comment": "Welcome preview meeting example source note.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I needed to clarify the deadline and ask who owns the next step."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开会时我想确认截止时间，也想问下一步由谁负责。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitaba aclarar el plazo y preguntar quien se encarga del siguiente paso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切りを確認し、次の担当者を聞く必要がありました。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je devais clarifier l echeance et demander qui prend la suite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich musste die Frist klaeren und fragen, wer den naechsten Schritt uebernimmt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의에서 마감일을 확인하고 다음 단계를 누가 맡는지 물어봐야 했습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мне нужно было уточнить срок и спросить, кто отвечает за следующий шаг."
          }
        }
      }
    },
