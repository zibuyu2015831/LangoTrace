    "settings.interfaceLanguage.summary": {
      "comment": "Interface language settings summary.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The default follows the system. Unsupported system languages fall back to English."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前默认跟随系统，未支持的系统语言回退英文。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto sigue el sistema. Los idiomas de sistema no admitidos vuelven a inglés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定ではシステムに従います。未対応のシステム言語は英語に戻ります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, suit le système. Les langues système non prises en charge reviennent à l’anglais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig folgt die App dem System. Nicht unterstützte Systemsprachen fallen auf Englisch zurück."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 시스템을 따릅니다. 지원하지 않는 시스템 언어는 영어로 돌아갑니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию следует системе. Неподдерживаемые системные языки возвращаются к английскому."
          }
        }
      }
    },
