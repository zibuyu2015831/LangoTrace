    "onboarding.level.summary": {
      "comment": "Onboarding level helper text.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used to tune generated material. You can change it later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于调整生成难度，之后可以随时修改。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para ajustar el material generado. Puedes cambiarlo más tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成される教材の難易度調整に使います。後で変更できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour ajuster les supports générés. Vous pourrez le modifier plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, um generiertes Material anzupassen. Du kannst es später ändern."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성되는 자료의 난이도를 조정하는 데 사용됩니다. 나중에 변경할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для настройки созданных материалов. Позже это можно изменить."
          }
        }
      }
    },
