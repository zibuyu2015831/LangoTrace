    "privacyStatus.sync.summary.configured": {
      "comment": "Sync privacy summary when sync is configured.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only data within your configured scope is synced. Keys and unselected data never enter the synced content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅同步你配置范围内的数据。密钥和未选择的数据不会进入同步内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se sincronizan los datos dentro del alcance configurado. Las claves y los datos no seleccionados nunca entran en el contenido sincronizado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した範囲内のデータのみ同期されます。キーや選択していないデータが同期内容に含まれることはありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les données dans le périmètre configuré sont synchronisées. Les clés et les données non sélectionnées n'entrent jamais dans le contenu synchronisé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Daten innerhalb des konfigurierten Umfangs werden synchronisiert. Schlüssel und nicht ausgewählte Daten gelangen nie in die Sync-Inhalte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 범위 내의 데이터만 동기화됩니다. 키와 선택하지 않은 데이터는 동기화 내용에 포함되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируются только данные в настроенных пределах. Ключи и невыбранные данные никогда не попадают в синхронизируемое содержимое."
          }
        }
      }
    },
    "privacyStatus.sync.summary.error": {
      "comment": "Sync privacy summary when sync failed or configuration is invalid.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync failed or the configuration is no longer valid. Check the destination, permissions, and network in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失败或配置失效。请在设置中检查目标位置、权限和网络状态。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización falló o la configuración ya no es válida. Revisa el destino, los permisos y la red en Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期に失敗したか、設定が無効になっています。設定で同期先・権限・ネットワーク状態を確認してください。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation a échoué ou la configuration n'est plus valide. Vérifiez la destination, les autorisations et le réseau dans Réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist fehlgeschlagen oder die Konfiguration ist ungültig. Prüfe Ziel, Berechtigungen und Netzwerk in den Einstellungen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화에 실패했거나 설정이 더 이상 유효하지 않습니다. 설정에서 대상 위치, 권한, 네트워크 상태를 확인하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация не удалась или конфигурация устарела. Проверьте назначение, разрешения и сеть в настройках."
          }
        }
      }
    },
    "privacyStatus.sync.summary.off": {
      "comment": "Sync privacy summary when sync is off.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on this device only. You can configure iCloud, WebDAV, S3, or R2 later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据仅保存在本机。你可以稍后配置 iCloud、WebDAV、S3 或 R2。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se guardan solo en este dispositivo. Puedes configurar iCloud, WebDAV, S3 o R2 más adelante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データはこのデバイスにのみ保存されます。iCloud・WebDAV・S3・R2 は後で設定できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent uniquement sur cet appareil. Vous pourrez configurer iCloud, WebDAV, S3 ou R2 plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten bleiben nur auf diesem Gerät. Du kannst iCloud, WebDAV, S3 oder R2 später konfigurieren."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 이 기기에만 저장됩니다. iCloud, WebDAV, S3 또는 R2는 나중에 설정할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные хранятся только на этом устройстве. Позже можно настроить iCloud, WebDAV, S3 или R2."
          }
        }
      }
    },
    "privacyStatus.sync.summary.paused": {
      "comment": "Sync privacy summary while paused.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync is paused. Data keeps being saved on this device and syncs again within the configured scope after you resume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步已暂停。数据继续保存在本机，恢复后再同步配置范围内的数据。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está en pausa. Los datos se siguen guardando en este dispositivo y se sincronizarán de nuevo dentro del alcance configurado al reanudar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期は一時停止中です。データは引き続きこのデバイスに保存され、再開後に設定した範囲内で再び同期されます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est en pause. Les données restent enregistrées sur cet appareil et se synchroniseront à nouveau dans le périmètre configuré après la reprise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung ist pausiert. Daten werden weiter auf diesem Gerät gespeichert und nach dem Fortsetzen wieder im konfigurierten Umfang synchronisiert."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화가 일시 중지되었습니다. 데이터는 계속 이 기기에 저장되며, 재개 후 설정한 범위 내에서 다시 동기화됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация приостановлена. Данные продолжают сохраняться на этом устройстве и снова синхронизируются в настроенных пределах после возобновления."
          }
        }
      }
    },
    "privacyStatus.sync.summary.syncing": {
      "comment": "Sync privacy summary while syncing.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing data within the configured scope. Sync never includes keys or unselected history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在同步配置范围内的数据。同步不会包含密钥或未选择的历史记录。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizando los datos dentro del alcance configurado. La sincronización nunca incluye claves ni historial no seleccionado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した範囲内のデータを同期しています。同期にキーや選択していない履歴が含まれることはありません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisation des données dans le périmètre configuré. La synchronisation n'inclut jamais les clés ni l'historique non sélectionné."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten im konfigurierten Umfang werden synchronisiert. Die Synchronisierung enthält nie Schlüssel oder nicht ausgewählten Verlauf."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 범위 내의 데이터를 동기화하고 있습니다. 동기화에는 키나 선택하지 않은 기록이 포함되지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт синхронизация данных в настроенных пределах. Синхронизация никогда не включает ключи или невыбранную историю."
          }
        }
      }
    },
