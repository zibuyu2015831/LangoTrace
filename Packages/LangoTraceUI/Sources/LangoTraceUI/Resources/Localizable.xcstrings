          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Echte Persistenz von Sprachräumen und Wiederherstellung beim Start hinzufügen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
