    "aiProviderSettings.apiKey.helper.unsaved": {
      "comment": "Helper text shown when no API key has been saved.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter or paste an API Key, then save to store it in the local Keychain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入或粘贴 API Key 后保存，会写入本机 Keychain。"
          }
        }
      }
    },
    "aiProviderSettings.apiKey.hide": {
      "comment": "Accessibility label for hiding the visible AI provider API key.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide API Key"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏 API Key"
          }
        }
      }
    },
    "aiProviderSettings.apiKey.placeholder": {
