    "welcome.tracePreview.examples.cafe.sourceNote": {
      "comment": "Welcome preview cafe example source note. Fixed bilingual demo copy across interface languages. Welcome demo content switches target language by interface language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I took a photo of my coffee and wanted to learn a polite takeaway phrase."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我拍下咖啡，想学会礼貌地说外带。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hice una foto de mi cafe y queria aprender a pedirlo para llevar con cortesia."
          }
