          "stringUnit": {
            "state": "translated",
            "value": "Data is stored on this device by default. Review and adjust it in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据默认保存在本机，可在设置中查看与调整。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos se guardan en este dispositivo por defecto. Revísalos y ajústalos en Ajustes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データは既定でこのデバイスに保存されます。設定で確認・調整できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données sont stockées sur cet appareil par défaut. Vous pouvez les consulter et les ajuster dans les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten werden standardmäßig auf diesem Gerät gespeichert. Du kannst dies in den Einstellungen prüfen und anpassen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 기본적으로 이 기기에 저장됩니다. 설정에서 확인하고 조정할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию данные хранятся на этом устройстве. Их можно просмотреть и настроить в настройках."
          }
        }
      }
    },
