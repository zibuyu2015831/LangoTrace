    "settings.interfaceLanguage.nextRequirement": {
      "comment": "Interface language settings next requirement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep String Catalog coverage, system per-app language boundary notes, and interface language preference persistence aligned."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 String Catalog、系统 per-app language 关系说明和界面语言偏好持久化一致。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener alineados String Catalog, notas sobre per-app language del sistema y persistencia de la preferencia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "String Catalog、システムのper-app language境界メモ、界面言語設定の永続化を揃えて保ちます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder alignés le String Catalog, les notes de limite per-app language système et la persistance de la préférence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "String Catalog, Hinweise zur System-per-app-language-Grenze und Persistenz der Oberflächensprache konsistent halten."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "String Catalog, 시스템 per-app language 경계 설명, 인터페이스 언어 선호 저장을 일관되게 유지합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизировать String Catalog, заметки о системном per-app language и сохранение языковой настройки."
          }
        }
      }
    },
