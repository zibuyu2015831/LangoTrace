    },
    "onboarding.privacy.noExternalAI": {
      "comment": "Onboarding AI privacy note.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No entry is sent while AI is not configured. AI, sync, dictionaries and prompts can be set up later."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置 AI 时不会发送任何记录。AI、同步、词典和 Prompt 都可以稍后在设置中处理。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se envía ninguna entrada mientras la IA no esté configurada. IA, sincronización, diccionarios y prompts se pueden configurar más tarde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIが未設定の間、記録は送信されません。AI、同期、辞書、Promptは後で設定できます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entrée n’est envoyée tant que l’IA n’est pas configurée. IA, synchronisation, dictionnaires et prompts pourront être configurés plus tard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange KI nicht konfiguriert ist, wird kein Eintrag gesendet. KI, Sync, Wörterbücher und Prompts können später eingerichtet werden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI가 설정되지 않은 동안에는 어떤 기록도 전송되지 않습니다. AI, 동기화, 사전, Prompt는 나중에 설정할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ИИ не настроен, записи не отправляются. ИИ, синхронизацию, словари и prompt можно настроить позже."
          }
        }
      }
    },
    "onboarding.subtitle": {
      "comment": "Onboarding subtitle.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A language space is a long-term learning profile for one target language. Start with the minimum setup, then turn life into learning material."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个语言空间，就是一门目标语言的长期学习档案。先记录最少信息，之后再开始把生活变成学习材料。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espacio de idioma es un perfil de aprendizaje a largo plazo para un idioma objetivo. Empieza con la configuración mínima y convierte la vida en material de aprendizaje."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語スペースは、1つの目標言語のための長期学習プロファイルです。最小限の設定から始め、生活を学習素材に変えていきます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un espace de langue est un profil d’apprentissage à long terme pour une langue cible. Commencez avec la configuration minimale, puis transformez la vie en support d’apprentissage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Sprachraum ist ein langfristiges Lernprofil für eine Zielsprache. Beginne mit der minimalen Einrichtung und mache Alltag zu Lernmaterial."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어 공간은 하나의 목표 언어를 위한 장기 학습 프로필입니다. 최소 설정으로 시작한 뒤 생활을 학습 자료로 바꿉니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Языковое пространство — это долгосрочный профиль обучения для одного целевого языка. Начните с минимальной настройки и превращайте жизнь в учебный материал."
          }
        }
      }
    },
