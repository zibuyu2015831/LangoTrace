    "settings.interfaceLanguage.systemBoundary": {
      "comment": "Interface language setting system UI boundary explanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows the device language or the per-app language chosen for LangoTrace. System dialogs, StoreKit, file pickers, and third-party UI may still follow platform rules."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统会使用设备语言或系统为语迹设置的 App 语言。系统弹窗、StoreKit、文件选择器和第三方 UI 仍可能遵循平台规则。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema sigue el idioma del dispositivo o el idioma por app elegido para LangoTrace. Diálogos del sistema, StoreKit, selectores de archivos e interfaces de terceros pueden seguir reglas de la plataforma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムはデバイス言語、またはLangoTraceに選ばれたAppごとの言語に従います。システムダイアログ、StoreKit、ファイル選択、第三者UIはプラットフォーム規則に従う場合があります。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système suit la langue de l’appareil ou la langue par app choisie pour LangoTrace. Les dialogues système, StoreKit, sélecteurs de fichiers et UI tierces peuvent suivre les règles de la plateforme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System folgt der Gerätesprache oder der für LangoTrace gewählten App-Sprache. Systemdialoge, StoreKit, Dateiauswahl und Drittanbieter-UI können Plattformregeln folgen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 따르기는 기기 언어 또는 LangoTrace에 대해 선택된 앱별 언어를 사용합니다. 시스템 대화상자, StoreKit, 파일 선택기, 타사 UI는 플랫폼 규칙을 따를 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система следует языку устройства или языку приложения, выбранному для LangoTrace. Системные диалоги, StoreKit, выбор файлов и сторонний UI могут следовать правилам платформы."
          }
        }
      }
    },
