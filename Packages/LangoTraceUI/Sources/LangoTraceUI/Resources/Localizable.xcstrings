    "settings.interfaceLanguage.contentBoundary": {
      "comment": "Interface language setting content boundary explanation.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not change your native language, target language, language spaces, saved entries, generated content, or Provider output."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会改变母语、目标语言、语言空间、已保存记录、已生成内容或 Provider 输出。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no cambia tu lengua materna, idioma objetivo, espacios de idioma, entradas guardadas, contenido generado ni salida del Provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "母語、目標言語、言語スペース、保存済み記録、生成済みコンテンツ、Provider出力は変更されません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne modifie pas votre langue maternelle, langue cible, espaces de langue, entrées enregistrées, contenu généré ni sortie Provider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ändert nicht Muttersprache, Zielsprache, Sprachräume, gespeicherte Einträge, generierte Inhalte oder Provider-Ausgaben."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모국어, 목표 언어, 언어 공간, 저장된 기록, 생성된 콘텐츠, Provider 출력은 변경하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не меняет родной язык, целевой язык, языковые пространства, сохраненные записи, созданный контент или вывод Provider."
          }
        }
      }
    },
    "settings.interfaceLanguage.detail": {
      "comment": "Interface language settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interface language only affects app chrome. It does not change the user's native language, target language, or rewrite generated content."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "界面语言只影响 App chrome，不改变用户母语、不改变目标语言，也不重写已生成内容。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de interfaz solo afecta al chrome de la app. No cambia la lengua materna, el idioma objetivo ni reescribe contenido generado."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "界面言語はアプリのchromeだけに影響します。母語や目標言語を変えず、生成済みコンテンツも書き換えません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue d’interface n’affecte que le chrome de l’app. Elle ne change pas la langue maternelle, la langue cible et ne réécrit pas le contenu généré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Oberflächensprache betrifft nur die App-Chrome. Sie ändert weder Muttersprache noch Zielsprache und schreibt keine generierten Inhalte um."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터페이스 언어는 앱 chrome에만 영향을 줍니다. 모국어, 목표 언어를 바꾸거나 생성된 콘텐츠를 다시 쓰지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык интерфейса влияет только на chrome приложения. Он не меняет родной или целевой язык и не переписывает созданный контент."
          }
        }
      }
    },
