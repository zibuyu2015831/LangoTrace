    "settings.languageSpace.detail": {
      "comment": "Language space settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current language space only exists in app session state and is used to validate onboarding and page closure."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前语言空间只存在于 App 会话状态中，用于验证首次启动和页面闭环。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El espacio de idioma actual solo existe en el estado de sesión de la app y se usa para validar onboarding y cierre de páginas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の言語スペースはアプリのセッション状態にのみ存在し、オンボーディングとページ閉鎖の検証に使われます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace de langue actuel n’existe que dans l’état de session de l’app et sert à valider l’onboarding et la clôture des pages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Sprachraum existiert nur im App-Sitzungszustand und validiert Onboarding und Seitenschluss."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 언어 공간은 앱 세션 상태에만 있으며 온보딩과 페이지 폐쇄를 검증하는 데 사용됩니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущее языковое пространство существует только в состоянии сеанса приложения и используется для проверки onboarding и закрытия страниц."
          }
        }
      }
    },
    "settings.languageSpace.nextRequirement": {
      "comment": "Language space settings next requirement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add real language space persistence and startup restoration."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入真实语言空间持久化和启动恢复。"
          }
        },
        "es": {
