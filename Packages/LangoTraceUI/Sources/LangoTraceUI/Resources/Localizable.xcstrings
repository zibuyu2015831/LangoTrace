    "welcome.tracePreview.examples.commute.sourceNote": {
      "comment": "Welcome preview commute example source note. Fixed bilingual demo copy across interface languages. Welcome demo content switches target language by interface language.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subway was delayed, so I noted the platform sign and wanted to ask if I should switch platforms."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地铁晚点了，我记下站台提示，想问是不是要换站台。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El metro se retraso, anote el aviso del anden y queria preguntar si debia cambiar de anden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地下鉄が遅れたので、ホームの案内をメモし、乗り場を変えるべきか聞きたい。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le metro avait du retard, j ai note l annonce du quai et je voulais demander s il fallait changer de quai."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die U-Bahn hatte Verspaetung, ich notierte den Hinweis am Bahnsteig und wollte fragen, ob ich den Bahnsteig wechseln muss."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지하철이 지연되어 승강장 안내를 적어 두고 승강장을 바꿔야 하는지 묻고 싶었다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Метро задерживалось, я записал объявление на платформе и хотел спросить, нужно ли перейти на другую платформу."
          }
        }
      }
    },
