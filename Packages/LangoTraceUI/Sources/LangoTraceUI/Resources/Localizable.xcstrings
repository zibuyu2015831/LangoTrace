        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe el momento de vida que se guardará localmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルに保存する生活の一場面を書きます。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédige le moment de vie qui sera enregistré localement."
          }
