    "settings.detail.noSideEffects.body": {
      "comment": "Settings detail panel body for unavailable side effects.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This page will not save secrets, write to a real database, access photos or microphone, or make network requests."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本页不会保存密钥、不会写入真实数据库、不会访问照片或麦克风、不会发起网络请求。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página no guardará secretos, no escribirá en una base de datos real, no accederá a fotos ni micrófono y no hará solicitudes de red."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページはシークレットを保存せず、実データベースに書き込まず、写真やマイクにアクセスせず、ネットワークリクエストも行いません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page n’enregistrera pas de secrets, n’écrira pas dans une vraie base de données, n’accédera pas aux photos ni au micro et n’effectuera aucune requête réseau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Seite speichert keine Geheimnisse, schreibt nicht in eine echte Datenbank, greift nicht auf Fotos oder Mikrofon zu und stellt keine Netzwerkanfragen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 페이지는 비밀 정보를 저장하지 않고, 실제 데이터베이스에 쓰지 않으며, 사진이나 마이크에 접근하지 않고, 네트워크 요청을 하지 않습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта страница не сохраняет секреты, не пишет в настоящую базу данных, не обращается к фото или микрофону и не выполняет сетевые запросы."
          }
        }
      }
    },
    "settings.export.detail": {
      "comment": "Export settings detail body.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no real database or attachment directory yet, so the app cannot generate a complete export package."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有真实数据库和附件目录，因此不能生成完整导出包。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay base de datos real ni directorio de adjuntos, así que la app no puede generar un paquete de exportación completo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ実データベースや添付ファイルディレクトリがないため、完全なエクスポートパッケージは生成できません。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas encore de vraie base de données ni de dossier de pièces jointes ; l’app ne peut donc pas générer un paquet d’export complet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt noch keine echte Datenbank und kein Anhangsverzeichnis, daher kann die App kein vollständiges Exportpaket erzeugen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 실제 데이터베이스나 첨부 파일 디렉터리가 없어 완전한 내보내기 패키지를 만들 수 없습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настоящей базы данных и каталога вложений пока нет, поэтому приложение не может создать полный пакет экспорта."
          }
        }
      }
    },
    "settings.export.nextRequirement": {
      "comment": "Export settings next requirement.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the data layer is stable, design Markdown, JSON, and attachment export."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在数据层稳定后设计 Markdown、JSON 和附件导出。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la capa de datos sea estable, diseñar exportación Markdown, JSON y adjuntos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ層が安定した後、Markdown、JSON、添付ファイルのエクスポートを設計します。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois la couche de données stable, concevoir l’export Markdown, JSON et pièces jointes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Stabilisierung der Datenschicht Markdown-, JSON- und Anhangsexport entwerfen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터 계층이 안정된 뒤 Markdown, JSON, 첨부 파일 내보내기를 설계합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После стабилизации слоя данных спроектировать экспорт Markdown, JSON и вложений."
          }
        }
      }
    },
