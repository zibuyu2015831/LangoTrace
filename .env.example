# LangoTrace 环境配置文件模板
# 
# 作用：
# 该文件用于定义开发、测试（如 Tests/AIProviderIntegration 下的探针脚本）所需的环境变量。
# 复制此文件并重命名为 `.env`，然后填入真实的凭据信息。
# 注意：`.env` 文件包含敏感的 API Key，绝不能被提交到 Git 仓库中。

# ==========================================
# AI Provider 集成测试配置 (Tests/AIProviderIntegration)
# ==========================================

# AI 服务提供商的 API 密钥。必须填写。
# 示例: sk-xxxxxxxxx
AI_PROVIDER_API_KEY=your_api_key_here

# AI 服务的 Base URL。通常必须包含协议(http/https)，对于兼容 OpenAI 接口的通常以 /v1 结尾。
# 目前系统支持的常用 Provider 及其 Base URL 参考：
# - OpenAI: https://api.openai.com/v1
# - Anthropic: https://api.anthropic.com/v1
# - Gemini (Google): https://generativelanguage.googleapis.com/v1beta
# - OpenRouter: https://openrouter.ai/api/v1
AI_PROVIDER_BASE_URL=https://api.openai.com/v1

# 用于“文本交互 (Chat Completion)”和“JSON 输出”的语言模型名称。
# 示例: gpt-4o-mini, claude-3-5-sonnet-20240620
AI_PROVIDER_TEXT_MODEL=gpt-4o-mini

# 用于“向量化 (Embeddings)”的模型名称。
# 示例: text-embedding-3-small
AI_PROVIDER_EMBEDDING_MODEL=text-embedding-3-small

# 用于“语音合成 (TTS)”的模型名称。
# 示例: tts-1
AI_PROVIDER_TTS_MODEL=tts-1

# 用于“语音合成 (TTS)”的声音配置（发音人）。
# 示例: alloy, echo, fable, onyx, nova, shimmer
AI_PROVIDER_TTS_VOICE=alloy

# ==========================================
# 其它开发和探测脚本配置 (可选)
# ==========================================
# scripts/probe_openai_compatible_api.py 等脚本可能依赖以下标准的 OpenAI 环境变量：
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
